{
  "name": "dsplat/multi-tenant-saas-module-review",
  "description": "多态评价 - 通用评价提交/审核/只读聚合（course/product 等实体）",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "MultiTenantSaas\\Modules\\Review\\": ""
    }
  },
  "require": {
    "php": "^8.3",
    "dsplat/multi-tenant-saas": "^1.0 || ^2.0 || ^3.0",
    "dsplat/multi-tenant-saas-base": "^3.5"
  },
  "extra": {
    "saas": {
      "name": "review",
      "priority": 300,
      "dependencies": [],
      "conflicts": [],
      "requires_core": ">=1.0.0 <4.0.0",
      "provider": "MultiTenantSaas\\Modules\\Review\\ReviewServiceProvider",
      "tenant_toggleable": true,
      "module_loadable": true,
      "default_tenant_enabled": true
    }
  }
}
